# Azure Blob URL for Redoubt 4 Grid 7 inline video (public URL or SAS).
# Prefer server-only (not in client JS): restart dev server after changing.
# REDOUBT4_GRID7_VIDEO_URL=https://YOUR_ACCOUNT.blob.core.windows.net/YOUR_CONTAINER/media/redoubt-4-grid-7.mp4?sv=...
#
# Alternative: public URL only (inlined at build for client bundles).
# NEXT_PUBLIC_REDOUBT4_GRID7_VIDEO_URL=https://YOUR_ACCOUNT.blob.core.windows.net/YOUR_CONTAINER/media/redoubt-4-grid-7.mp4
